# ------------------------------------------------------------------
# Serveur — copier ce fichier en `.env` à la racine du projet
# ------------------------------------------------------------------

# Mot de passe de l'espace organisateur (/admin). OBLIGATOIRE.
ADMIN_PASSWORD=change-moi

# Port HTTP + Socket.IO du serveur
PORT=3001

# Origines autorisées pour CORS (séparées par des virgules).
# En dev, le client Vite tourne sur http://localhost:5173.
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# ------------------------------------------------------------------
# Client (facultatif) — voir client/.env.example
# Pour une app Capacitor, renseigner l'URL absolue du serveur :
# VITE_SERVER_URL=https://quiz.example.com
# ------------------------------------------------------------------
